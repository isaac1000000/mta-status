# Copy to .env and fill in. .env is gitignored; this template is committed.

# MTA Bus Time API key -- register at https://register.developer.obanyc.com/
MTA_BUS_API_KEY=

# Bus stop codes (SIRI MonitoringRef), direction-specific. Discover them with:
#     venv/bin/python bus.py find Q69 <search>
Q69_STOP=
Q100_STOP=

# BCM GPIO pin the mode button is wired to (button between this pin and ground).
BUTTON_GPIO=
